<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for the finances dashboard.

  Install:
    cp scripts/net.personal-projects.finances-dashboard.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/net.personal-projects.finances-dashboard.plist

  Start/stop:
    launchctl start net.personal-projects.finances-dashboard
    launchctl stop  net.personal-projects.finances-dashboard

  View logs:
    tail -f ~/Library/Logs/finances-dashboard.log
    tail -f ~/Library/Logs/finances-dashboard.error.log

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/net.personal-projects.finances-dashboard.plist
    rm ~/Library/LaunchAgents/net.personal-projects.finances-dashboard.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.personal-projects.finances-dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/oliverwarwick/.local/bin/uv</string>
        <string>run</string>
        <string>--directory</string>
        <string>/Users/oliverwarwick/playground/personal_projects</string>
        <string>finances-dashboard</string>
        <string>--auth-db</string>
        <string>/Users/oliverwarwick/.config/personal_project/finances_auth.db</string>
        <string>--port</string>
        <string>8765</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/oliverwarwick/playground/personal_projects</string>

    <!-- Start automatically at login and keep running if it exits -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Restart throttle: don't respawn faster than every 10 seconds -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/oliverwarwick/Library/Logs/finances-dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/oliverwarwick/Library/Logs/finances-dashboard.error.log</string>

    <!-- Pass HOME so uv can find its cache and .env files -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/oliverwarwick</string>
        <key>PATH</key>
        <string>/Users/oliverwarwick/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
