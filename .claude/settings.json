{
  "project": {
    "name": "personal-projects",
    "description": "Personal projects",
    "language": "python",
    "pythonVersion": "3.14"
  },
  "tooling": {
    "linter": "ruff",
    "formatter": "ruff",
    "typeChecker": "pyright",
    "packageManager": "uv"
  },
  "commands": {
    "lint": "uv run ruff check .",
    "lint:fix": "uv run ruff check --fix .",
    "format": "uv run ruff format .",
    "format:check": "uv run ruff format --check .",
    "typecheck": "uv run pyright",
    "check:all": "uv run ruff check . && uv run ruff format --check . && uv run pyright",
    "install": "uv sync --extra dev",
    "update": "uv sync --upgrade",
    "clean": "rm -rf .ruff_cache"
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh auth status:*)",
      "Bash(export PATH=*)",
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(which:*)"
    ]
  }
}
